{
  "name": "menu",
  "entities": [
    { "id": "cam", "components": { "Transform": { "x": 0, "y": 0, "fixed": false }, "Camera": { "zoom": 1, "offset": { "x": 0, "y": 0 } } } },
    { "id": "bg", "components": { "Transform": { "x": 2000, "y": 2000, "fixed": true, "zIndex": -100 }, "ShapeRenderer": { "shape": "rect", "width": 4000, "height": 4000, "color": "#0e0f16" } } },

    { "id": "content", "components": { "Transform": { "x": 0, "y": 0, "fixed": true } } },
    { "id": "menuTitle", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "center", "offsetY": -110 },
      "TextRenderer": { "text": "On Borrowed Time", "fontFamily": "VT323", "googleFont": true, "fontSize": 52, "color": "#ffffff", "align": "center" }
    } },
    { "id": "menuSubtitle", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "center", "offsetY": -58 },
      "TextRenderer": { "text": "Your time is your health.", "fontFamily": "VT323", "googleFont": true, "fontSize": 20, "color": "#8ea0ff", "align": "center" }
    } },

    { "id": "playBtn", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "center", "offsetY": 20 },
      "ShapeRenderer": { "shape": "rect", "width": 220, "height": 52, "color": "#2f6f4e" },
      "TextRenderer": { "text": "Play", "fontFamily": "VT323", "googleFont": true, "fontSize": 24, "color": "#ffffff", "align": "center", "verticalAlign": "middle" },
      "Interactable": {
        "width": 220,
        "height": 52,
        "cursor": "pointer",
        "onClick": "engine.loadScene('main');"
      }
    } },
    { "id": "tutorialBtn", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "center", "offsetY": 90 },
      "ShapeRenderer": { "shape": "rect", "width": 220, "height": 52, "color": "#2a2d38" },
      "TextRenderer": { "text": "Tutorial (Soon)", "fontFamily": "VT323", "googleFont": true, "fontSize": 22, "color": "#6b7080", "align": "center", "verticalAlign": "middle" },
      "Interactable": {
        "width": 220,
        "height": 52,
        "cursor": "not-allowed"
      }
    } }
  ]
}
