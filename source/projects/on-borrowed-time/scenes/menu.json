{
  "name": "menu",
  "entities": [
    { "id": "cam", "components": { "Transform": { "x": 0, "y": 0, "fixed": false }, "Camera": { "zoom": 1, "offset": { "x": 0, "y": 0 } } } },
    { "id": "bg", "components": { "Transform": { "x": 2000, "y": 2000, "fixed": true, "zIndex": -100 }, "ShapeRenderer": { "shape": "rect", "width": 4000, "height": 4000, "color": "#1a1b22" } } },

    { "id": "content", "components": { "Transform": { "x": 0, "y": 0, "fixed": true } } },
    { "id": "menuTitle", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "center", "offsetY": -98 },
      "SpriteRenderer": { "sprite": "title", "frame": "TitleAnimation_0", "width": 480, "height": 120 },
      "SpriteAnimation": { "clip": "Play", "playing": true }
    } },
    { "id": "menuSubtitle", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "center", "offsetY": -16 },
      "TextRenderer": { "text": "Your time is your health.", "fontFamily": "VT323", "googleFont": true, "fontSize": 20, "color": "#8ea0ff", "align": "center" }
    } },

    { "id": "playBtn", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "center", "offsetY": 62 },
      "ShapeRenderer": { "shape": "rect", "width": 220, "height": 52, "color": "#2f6f4e" },
      "TextRenderer": { "text": "Play", "fontFamily": "VT323", "googleFont": true, "fontSize": 24, "color": "#ffffff", "align": "center", "verticalAlign": "middle" },
      "Interactable": {
        "width": 220,
        "height": 52,
        "cursor": "pointer",
        "onClick": "engine.callScript('MenuPlay', entity, engine);"
      }
    } },
    { "id": "tutorialBtn", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "center", "offsetY": 132 },
      "ShapeRenderer": { "shape": "rect", "width": 220, "height": 52, "color": "#3a4a6b" },
      "TextRenderer": { "text": "Tutorial", "fontFamily": "VT323", "googleFont": true, "fontSize": 24, "color": "#ffffff", "align": "center", "verticalAlign": "middle" },
      "Interactable": {
        "width": 220,
        "height": 52,
        "cursor": "pointer",
        "onClick": "engine.callScript('MenuTutorial', entity, engine);"
      }
    } },
    { "id": "directoryBtn", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "top-right", "offsetX": -110, "offsetY": 40 },
      "ShapeRenderer": { "shape": "rect", "width": 180, "height": 44, "color": "#4a3a6b" },
      "TextRenderer": { "text": "Card Directory", "fontFamily": "VT323", "googleFont": true, "fontSize": 18, "color": "#ffffff", "align": "center", "verticalAlign": "middle" },
      "Interactable": {
        "width": 180,
        "height": 44,
        "cursor": "pointer",
        "onClick": "engine.callScript('MenuCardDirectory', entity, engine);"
      }
    } }
  ]
}
