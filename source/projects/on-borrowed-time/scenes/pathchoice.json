{
  "name": "pathchoice",
  "entities": [
    { "id": "cam", "components": { "Transform": { "x": 0, "y": 0, "fixed": false }, "Camera": { "zoom": 1, "offset": { "x": 0, "y": 0 } } } },
    { "id": "bg", "components": { "Transform": { "x": 2000, "y": 2000, "fixed": true, "zIndex": -100 }, "ShapeRenderer": { "shape": "rect", "width": 4000, "height": 4000, "color": "#161029" } } },

    { "id": "controller", "components": { "Transform": { "x": 0, "y": 0, "fixed": true } }, "scripts": ["PathChoiceController"] },

    { "id": "hud", "components": { "Transform": { "x": 0, "y": 0, "fixed": true } } },
    { "id": "pathChoiceTitle", "parentId": "hud", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "top-center", "offsetY": 18 },
      "TextRenderer": { "text": "Round Won — Choose a Perk", "fontFamily": "VT323", "googleFont": true, "fontSize": 28, "color": "#ffffff", "align": "center" }
    } },
    { "id": "pathChoiceDeckCount", "parentId": "hud", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "top-left", "offsetX": 16, "offsetY": 14 },
      "TextRenderer": { "text": "Deck: 0 cards", "fontFamily": "VT323", "googleFont": true, "fontSize": 22, "color": "#ffffff" }
    } },

    { "id": "fadeOverlay", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true, "zIndex": 9999 },
      "Anchor": { "anchor": "center" },
      "ShapeRenderer": { "shape": "rect", "width": 3000, "height": 3000, "color": "#000000" },
      "Opacity": { "value": 1 },
      "Animator": {}
    } }
  ]
}
