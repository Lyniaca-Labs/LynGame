{
  "name": "gameover",
  "entities": [
    { "id": "cam", "components": { "Transform": { "x": 0, "y": 0, "fixed": false }, "Camera": { "zoom": 1, "offset": { "x": 0, "y": 0 } } } },
    { "id": "bg", "components": { "Transform": { "x": 2000, "y": 2000, "fixed": true, "zIndex": -100 }, "ShapeRenderer": { "shape": "rect", "width": 4000, "height": 4000, "color": "#281a1a" } } },

    { "id": "controller", "components": { "Transform": { "x": 0, "y": 0, "fixed": true } }, "scripts": ["GameOverController"] },

    { "id": "fadeOverlay", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true, "zIndex": 9999 },
      "Anchor": { "anchor": "center" },
      "ShapeRenderer": { "shape": "rect", "width": 3000, "height": 3000, "color": "#000000" },
      "Opacity": { "value": 1 },
      "Animator": {}
    } },

    { "id": "content", "components": { "Transform": { "x": 0, "y": 0, "fixed": true } } },
    { "id": "newBestBanner", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "center", "offsetY": -118 },
      "TextRenderer": { "text": "NEW BEST!", "fontFamily": "VT323", "googleFont": true, "fontSize": 30, "color": "#ffd76a", "align": "center" },
      "Animator": { "clips": [] },
      "Opacity": { "value": 0 }
    } },
    { "id": "gameOverTitle", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "center", "offsetY": -70 },
      "TextRenderer": { "text": "Time's Up", "fontFamily": "VT323", "googleFont": true, "fontSize": 52, "color": "#ff8e8e", "align": "center" }
    } },
    { "id": "gameOverStats", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "center", "offsetY": -6 },
      "TextRenderer": { "text": "", "fontFamily": "VT323", "googleFont": true, "fontSize": 22, "color": "#e5e7eb", "align": "center", "lineHeight": 1.5 }
    } },
    { "id": "gameOverMeta", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "top-left", "offsetX": 16, "offsetY": 14 },
      "TextRenderer": { "text": "", "fontFamily": "VT323", "googleFont": true, "fontSize": 16, "color": "#8b93a7", "align": "left", "lineHeight": 1.4, "maxWidth": 200, "wrap": true }
    } },
    { "id": "restartBtn", "parentId": "content", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "center", "offsetY": 140 },
      "ShapeRenderer": { "shape": "rect", "width": 220, "height": 52, "color": "#7f2d2d" },
      "TextRenderer": { "text": "Main Menu", "fontFamily": "VT323", "googleFont": true, "fontSize": 24, "color": "#ffffff", "align": "center", "verticalAlign": "middle" },
      "Animator": {},
      "Interactable": {
        "width": 220,
        "height": 52,
        "cursor": "pointer",
        "onClick": "engine.callScript('GameoverRetry', entity, engine);",
        "onHoverEnter": "engine.callScript('ButtonHoverEnter', entity, engine);",
        "onHoverExit": "engine.callScript('ButtonHoverExit', entity, engine);"
      }
    } }
  ]
}
