{
  "name": "shop",
  "entities": [
    { "id": "cam", "components": { "Transform": { "x": 0, "y": 0, "fixed": false }, "Camera": { "zoom": 1, "offset": { "x": 0, "y": 0 } } } },
    { "id": "bg", "components": { "Transform": { "x": 2000, "y": 2000, "fixed": true, "zIndex": -100 }, "ShapeRenderer": { "shape": "rect", "width": 4000, "height": 4000, "color": "#161029" } } },

    { "id": "controller", "components": { "Transform": { "x": 0, "y": 0, "fixed": true } }, "scripts": ["ShopController"] },

    { "id": "hud", "components": { "Transform": { "x": 0, "y": 0, "fixed": true } } },
    { "id": "shopTitle", "parentId": "hud", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "top-center", "offsetY": 20 },
      "TextRenderer": { "text": "Round Complete — Shop", "fontFamily": "VT323", "googleFont": true, "fontSize": 30, "color": "#ffffff", "align": "center" }
    } },
    { "id": "shopCurrency", "parentId": "hud", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "top-right", "offsetX": -16, "offsetY": 14 },
      "TextRenderer": { "text": "Coins: 0", "fontFamily": "VT323", "googleFont": true, "fontSize": 22, "color": "#ffd76a", "align": "right" }
    } },
    { "id": "shopDeckCount", "parentId": "hud", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "top-left", "offsetX": 16, "offsetY": 14 },
      "TextRenderer": { "text": "Deck: 0 cards", "fontFamily": "VT323", "googleFont": true, "fontSize": 22, "color": "#ffffff" }
    } },

    { "id": "shopBurst", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Emitter": {
        "enabled": false, "mode": "burst", "burstCount": 26, "burstInterval": 0,
        "angle": -90, "spread": 180, "speedMin": 60, "speedMax": 260,
        "lifetimeMin": 0.4, "lifetimeMax": 0.9,
        "particleTypes": [{ "shape": "circle", "color": ["#ffd76a", "#8ea0ff", "#4ade80", "#ffffff"], "size": [3, 7], "gravity": 180, "fadeOut": true }]
      }
    } },

    { "id": "continueBtn", "components": {
      "Transform": { "x": 0, "y": 0, "fixed": true },
      "Anchor": { "anchor": "bottom-center", "offsetY": -34 },
      "ShapeRenderer": { "shape": "rect", "width": 220, "height": 52, "color": "#2f6f4e" },
      "TextRenderer": { "text": "Continue →", "fontFamily": "VT323", "googleFont": true, "fontSize": 24, "color": "#ffffff", "align": "center", "verticalAlign": "middle" },
      "Interactable": {
        "width": 220,
        "height": 52,
        "cursor": "pointer",
        "onClick": "engine.callScript('ShopContinue', entity, engine);"
      }
    } }
  ]
}
