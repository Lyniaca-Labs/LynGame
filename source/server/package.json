  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "esbuild": "^0.28.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
