{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && powershell -NoProfile -Command \"Copy-Item -LiteralPath config/server.json -Destination dist/config/server.json -Force\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch --ignore \"../projects/**\" --ignore \"../output/**\" --ignore \"../.tmp-components/**\" --clear-screen=false index.ts"
  },
